# Database
DATABASE_URL=postgresql+asyncpg://sih1684:changeme@localhost:5432/sih1684
POSTGRES_PASSWORD=changeme

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Auth
SECRET_KEY=change-this-to-a-secure-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Demo Mode (set to true to auto-seed on startup)
DEMO_MODE=false

# External APIs
NVD_API_KEY=
OPENAI_API_KEY=

# Scanner Config
NMAP_PATH=/usr/bin/nmap
DEFAULT_SCAN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SCANS=3
